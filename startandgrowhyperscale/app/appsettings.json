{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Scheduling": "Server=tcp:{network-server}.database.windows.net,1433;Initial Catalog=caldova-scheduling;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connect Timeout=30"
  },
  "Demo": {
    "Mode": "Measured"
  },
  "ServerlessRecording": {
    "Mode": "Live",
    "File": "",
    "Speed": 2
  },
  "BookingReset": {
    "Enabled": false
  },
  "ServerlessMonitor": {
    "ResourceId": "/subscriptions/{subscription-id}/resourceGroups/caldova-network-rg/providers/Microsoft.Sql/servers/{network-server}/databases/caldova-scheduling",
    "EnableWorkload": false
  }
}
