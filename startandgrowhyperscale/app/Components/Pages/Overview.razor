@page "/network"

<PageTitle>Step 2 · Caldova acquisitions</PageTitle>
<section class="page-header">
    <p class="eyebrow">Step 2 · Grow the Caldova network</p>
    <h1>Caldova Health just acquired two providers</h1>
    <p>Bring their scheduling databases together without merging their data or rewriting their schedules.</p>
</section>
<div class="provider-grid">
    @foreach (var provider in providers)
    {
        <article class="provider-card">
            <header><span class="provider-tag">@provider.Role</span><h2>@provider.Name</h2></header>
            <dl>
                <div><dt>Database</dt><dd><code>@provider.Database</code></dd></div>
                <div><dt>Starting configuration</dt><dd>@provider.Compute</dd></div>
            </dl>
        </article>
    }
</div>
<section class="panel">
    <h2>One scheduling network, three independently owned databases</h2>
    <p>Each provider keeps its own scheduling database and schedule. Caldova staff search and book across all three.</p>
</section>

@code {
    private readonly (string Name, string Role, string Database, string Compute)[] providers =
    [
        ("Caldova Health", "Acquirer", "caldova-scheduling", "Hyperscale serverless · 1-8 vCores"),
        ("Northbrook Family Clinics", "Acquired · primary care and pediatrics", "northbrook-scheduling", "Provisioned Hyperscale · 2 vCores"),
        ("Ridgeview Specialty Care", "Acquired · cardiology and orthopedics", "ridgeview-scheduling", "Provisioned Hyperscale · 4 vCores"),
    ];
}
