@page "/network"

<PageTitle>Step 2 · Caldova acquisitions</PageTitle>
<section class="page-header">
    <p class="eyebrow">Step 2 · Grow the Caldova network</p>
    <h1>Caldova Health just acquired two providers</h1>
    <p>Bring their scheduling databases together without merging their data or rewriting their schedules.</p>
</section>
<div class="provider-grid">
    @foreach (var provider in providers)
    {
        <article class="provider-card">
            <header><span class="provider-tag">@provider.Role</span><h2>@provider.Name</h2></header>
            <dl>
                <div><dt>Database</dt><dd><code>@provider.Database</code></dd></div>
                <div><dt>Starting configuration</dt><dd>@provider.Compute</dd></div>
            </dl>
        </article>
    }
</div>
<section class="panel">
    <h2>One scheduling network, three independently owned databases</h2>
    <p>These cards describe the starting configuration, not live Azure status. The existing
        <code>caldova-network-pool</code> is enabled for native cross-database queries.</p>
    <button class="btn btn-primary" @onclick="() => showInstructions = true">Add these databases to a pool</button>
    @if (showInstructions)
    {
        <div class="callout callout-info" role="status">
            <strong>Run this prompt in the same GitHub Copilot chat:</strong>
            <p>Integrate Caldova's acquired providers into the scheduling pool.</p>
            <p>The <code>start-and-grow-hyperscale-demo</code> skill previews the changes and asks for approval.
                It adds the three databases to the existing pool; Caldova leaves serverless for provisioned compute.
                Stop scheduling traffic before approving the move.</p>
            <p>This button does not create a pool, move databases, or mark the operation complete.</p>
        </div>
    }
</section>
<div class="transport">
    <NavLink class="btn btn-secondary" href="/">Back · Step 1</NavLink>
    <NavLink class="btn btn-primary" href="/verify">Next · Step 3: verify in Azure</NavLink>
</div>

@code {
    private bool showInstructions;
    private readonly (string Name, string Role, string Database, string Compute)[] providers =
    [
        ("Caldova Health", "Acquirer", "caldova-scheduling", "Hyperscale serverless · 1-8 vCores"),
        ("Northbrook Family Clinics", "Acquired · primary care and pediatrics", "northbrook-scheduling", "Provisioned Hyperscale · 2 vCores"),
        ("Ridgeview Specialty Care", "Acquired · cardiology and orthopedics", "ridgeview-scheduling", "Provisioned Hyperscale · 4 vCores"),
    ];
}
