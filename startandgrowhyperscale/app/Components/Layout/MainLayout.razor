@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="shell">
    <header class="topbar">
        <div class="brand">
            <span class="brand-mark">C</span>
            <span>Caldova Network Scheduling</span>
            <span class="brand-sub">on Azure SQL Database Hyperscale</span>
        </div>
        <nav class="topnav" aria-label="Scenario steps">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item"><span class="nav-step">1</span>Patient Access</NavLink>
            <NavLink href="/network" class="nav-item"><span class="nav-step">2</span>Acquisitions</NavLink>
            <NavLink href="/verify" class="nav-item"><span class="nav-step">3</span>Verify Pool</NavLink>
            <NavLink href="/appointments" class="nav-item"><span class="nav-step">4</span>Search &amp; Book</NavLink>
        </nav>
        <div class="topbar-right">
            <span class="mode-chip">Serverless: @(IsIllustration ? "SCRIPTED ILLUSTRATION" : "SQL DMV") · Appointments: SQL</span>
        </div>

        @code {
            private bool IsIllustration => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/') == "serverless-illustration";
        }
    </header>
    <main class="content">@Body</main>
</div>
